# Copier ce fichier en .env et renseigner les valeurs.
# Le .env est ignoré par git : aucun secret ne doit être commité.

# --- Bucket S3 des factures (étape 1) ---
S3_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
S3_BUCKET=factures
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Modèle OCR LightOnOCR-3 sur Hyperfluid (étape 2) ---
# URL de la gateway (onglet "Endpoint" du modèle dans la console).
OCR_API_URL=https://llm.hyperfluid.cloud/v1/organizations/ebc6b7a8-9ecd-4d3d-bafc-fef40ebe986f/shared-models/lightonocr-3-1b-test/v1/chat/completions
OCR_MODEL=lightonocr-3-1b-test
# Ton token d'accès console (onglet "API Keys"). C'est un SECRET : il ne va que dans .env.
OCR_API_KEY=

# --- LLM de l'agent (étape 8) : interchangeable par configuration ---
# Fournisseur actif : "groq", "hyperfluid" ou "ollama".
LLM_PROVIDER=hyperfluid
# (optionnel) forcer un modèle précis, sinon défaut du fournisseur :
# LLM_MODEL=

# Groq (hébergé, gratuit) : https://console.groq.com
GROQ_API_KEY=gsk_...

# Hyperfluid : réutilise ta clé OCR (sk-hf...). Modèle de chat dispo : chat-m (gemma-4-12b).
# Si HYPERFLUID_API_KEY n'est pas mis, OCR_API_KEY est utilisée.
HYPERFLUID_LLM_URL=https://llm.hyperfluid.cloud/v1/organizations/ebc6b7a8-9ecd-4d3d-bafc-fef40ebe986f/shared-models/chat-m/v1
HYPERFLUID_API_KEY=

# Ollama (local) : https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Source des outils de l'agent : "mock" (fausses factures, pour tester) ou "mcp" (serveur de l'étape 7).
AGENT_BACKEND=mock
