# Copier ce fichier en .env et renseigner les valeurs.
# Le .env est ignoré par git : aucun secret ne doit être commité.

# --- Bucket S3 des factures (étape 1) ---
S3_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
S3_BUCKET=factures
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Modèle OCR LightOnOCR-3 sur Hyperfluid (étape 2) ---
OCR_API_URL=
OCR_API_KEY=

# --- LLM de l'agent (étape 8) : interchangeable par configuration ---
# Fournisseur actif : "groq" (hébergé) ou "ollama" (local), etc.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
OLLAMA_BASE_URL=http://localhost:11434
